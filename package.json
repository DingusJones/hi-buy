{
  "name": "hi-buy-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures:verify": "node --experimental-strip-types scripts/fixtures.mjs",
    "verify": "npm run typecheck && npm test && npm run fixtures:verify && npm run build"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "jsdom": "29.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
